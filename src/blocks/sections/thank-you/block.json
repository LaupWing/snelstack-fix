{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "snel/thank-you",
	"version": "1.0.0",
	"title": "Snel Thank You",
	"category": "snel",
	"icon": "yes-alt",
	"description": "Bedankpagina na het contactformulier — bevestiging, reactietijd en een knop om direct een gesprek in te plannen.",
	"keywords": ["bedankt", "thank you", "confirmation", "calendly"],
	"textdomain": "snel",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"supports": {
		"align": ["full", "wide"]
	},
	"attributes": {
		"align":        { "type": "string",  "default": "full" },
		"heading":      { "type": "string",  "default": "" },
		"paragraph":    { "type": "string",  "default": "" },
		"showCalendly": { "type": "boolean", "default": true },
		"calendlyUrl":  { "type": "string",  "default": "https://calendly.com/snelstack/30min" },
		"theme":        { "type": "string",  "default": "white" },
		"showBeams":    { "type": "boolean", "default": true },
		"showGradient": { "type": "boolean", "default": true }
	}
}
